<Window x:Class="GameMusicFlyout.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Music Flyout – Shortcut"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="18">
        <TextBlock Text="Press the new shortcut to show or hide the flyout."
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="#FF666666"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="Include Ctrl, Alt, or Win. Pick a combination your games don't use." />

        <Border Margin="0,14,0,0"
                Padding="10"
                BorderBrush="#FFBBBBBB"
                BorderThickness="1"
                CornerRadius="4"
                Background="#FFF7F7F7">
            <TextBlock x:Name="ShortcutText"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <TextBlock x:Name="ErrorText"
                   Margin="0,8,0,0"
                   Foreground="#FFC42B1C"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Padding="10,4"
                    Content="Reset to default"
                    Focusable="False"
                    Click="OnResetClick" />
            <Button DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Padding="14,4"
                    Content="Cancel"
                    Focusable="False"
                    Click="OnCancelClick" />
            <Button x:Name="SaveButton"
                    DockPanel.Dock="Right"
                    Padding="14,4"
                    Content="Save"
                    Focusable="False"
                    Click="OnSaveClick" />
        </DockPanel>
    </StackPanel>
</Window>
